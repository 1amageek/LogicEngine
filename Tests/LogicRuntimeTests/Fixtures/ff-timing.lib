library (fixture) {
  time_unit : "1ns";
  capacitive_load_unit (1, pf);
  cell (DFF) {
    area : 3;
    ff (IQ, IQN) { next_state : "D"; clocked_on : "CLK"; }
    pin (D) { direction : input;
      timing () { related_pin : "CLK"; timing_type : setup_rising;
        rise_constraint (t) { index_1 ("0.1"); index_2 ("0.0"); values ("0.2"); }
        fall_constraint (t) { index_1 ("0.1"); index_2 ("0.0"); values ("0.2"); }
      }
      timing () { related_pin : "CLK"; timing_type : hold_rising;
        rise_constraint (t) { index_1 ("0.1"); index_2 ("0.0"); values ("0.0"); }
        fall_constraint (t) { index_1 ("0.1"); index_2 ("0.0"); values ("0.0"); }
      }
    }
    pin (CLK) { direction : input; clock : true; }
    pin (Q) { direction : output; function : "IQ";
      timing () { related_pin : "CLK"; timing_type : rising_edge;
        cell_rise (t) { index_1 ("0.1"); index_2 ("0.0"); values ("0.5"); }
        cell_fall (t) { index_1 ("0.1"); index_2 ("0.0"); values ("0.5"); }
      }
    }
  }
}
